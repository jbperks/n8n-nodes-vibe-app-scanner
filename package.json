{
  "name": "n8n-nodes-vibe-app-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Start authorized VAS deployment scans and read coverage-safe scan summaries",
  "license": "MIT",
  "homepage": "https://vibeappscanner.com",
  "keywords": ["n8n-community-node-package", "security", "deployment"],
  "author": { "name": "Silex", "email": "admin@silexdev.com" },
  "repository": {
    "type": "git",
    "url": "https://github.com/jbperks/n8n-nodes-vibe-app-scanner.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "lint": "n8n-node lint",
    "test": "node --test test/*.test.cjs",
    "prepublishOnly": "node -e \"throw new Error('Local prototype: publication requires explicit approval and release review')\""
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/VibeAppScannerApi.credentials.js"],
    "nodes": ["dist/nodes/VibeAppScanner/VibeAppScanner.node.js"]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.53.4",
    "eslint": "9.29.0",
    "n8n-workflow": "2.44.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": { "n8n-workflow": "*" },
  "engines": { "node": ">=24.0.0" }
}
